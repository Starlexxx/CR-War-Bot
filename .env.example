TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. Only Telegram traffic goes through it; the Clash Royale API is always
# reached directly because its token is bound to this host's IP.
# Example: socks5://user:password@host:1080
TELEGRAM_PROXY=
CR_API_TOKEN=
CR_CLAN_TAG=#XXXXXXX
CR_API_BASE_URL=https://api.clashroyale.com/v1
DB_PATH=./data.db
POLL_INTERVAL_SECONDS=300
ROSTER_INTERVAL_SECONDS=3600
MISS_PENALTY=50
REMINDER_GRACE_MINUTES=30
LOG_LEVEL=INFO
